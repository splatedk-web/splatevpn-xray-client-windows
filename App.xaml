<Application x:Class="SplateClientDesktop.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:converters="clr-namespace:SplateClientDesktop.Converters">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>

            <converters:InverseBoolConverter x:Key="InverseBoolConverter"/>
            <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>

            <!-- Splate Cyber Tactical Palette (Matching Splate Android Client) -->
            <Color x:Key="BackgroundDarkColor">#070B14</Color>
            <Color x:Key="BackgroundDeepColor">#030509</Color>
            <Color x:Key="SurfaceDarkColor">#0F1626</Color>
            <Color x:Key="SurfaceElevatedColor">#151E33</Color>
            <Color x:Key="BorderSubtleColor">#1E2B42</Color>
            <Color x:Key="BorderMediumColor">#2A3B5A</Color>
            <Color x:Key="AccentCyanColor">#00F0FF</Color>
            <Color x:Key="AccentEmeraldColor">#10E79D</Color>
            <Color x:Key="AccentAmberColor">#FFB300</Color>
            <Color x:Key="AccentCrimsonColor">#FF3366</Color>
            <Color x:Key="AccentVioletColor">#A78BFA</Color>
            <Color x:Key="PrimaryBlueColor">#3B82F6</Color>

            <SolidColorBrush x:Key="AppBackgroundBrush" Color="#070B14"/>
            <SolidColorBrush x:Key="AppBackgroundDeepBrush" Color="#030509"/>
            <SolidColorBrush x:Key="AppSurfaceBrush" Color="#0F1626"/>
            <SolidColorBrush x:Key="AppSurfaceElevatedBrush" Color="#151E33"/>
            <SolidColorBrush x:Key="AppBorderSubtleBrush" Color="#1E2B42"/>
            <SolidColorBrush x:Key="AppBorderMediumBrush" Color="#2A3B5A"/>
            <SolidColorBrush x:Key="AppAccentCyanBrush" Color="#00F0FF"/>
            <SolidColorBrush x:Key="AppAccentEmeraldBrush" Color="#10E79D"/>
            <SolidColorBrush x:Key="AppAccentAmberBrush" Color="#FFB300"/>
            <SolidColorBrush x:Key="AppAccentCrimsonBrush" Color="#FF3366"/>
            <SolidColorBrush x:Key="AppAccentVioletBrush" Color="#A78BFA"/>
            <SolidColorBrush x:Key="AppPrimaryBlueBrush" Color="#3B82F6"/>

            <!-- Tactical Glass Card Style -->
            <Style x:Key="TacticalGlassCard" TargetType="ui:Card">
                <Setter Property="Background" Value="#CC0D1527"/>
                <Setter Property="BorderBrush" Value="#1E2B42"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>

            <Style x:Key="TacticalElevatedCard" TargetType="ui:Card">
                <Setter Property="Background" Value="#DD141F38"/>
                <Setter Property="BorderBrush" Value="#2A3B5A"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="16,14"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>