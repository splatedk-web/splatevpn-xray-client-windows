<Window x:Class="SplateClientDesktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        xmlns:viewmodels="clr-namespace:SplateClientDesktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="SplateVPN"
        Icon="pack://application:,,,/SplateClient;component/Assets/app.png"
        Height="780" Width="1120"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="False"
        Background="#070B14"
        d:DataContext="{d:DesignInstance viewmodels:MainViewModel}">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0"
                      ResizeBorderThickness="6"
                      CornerRadius="0"
                      GlassFrameThickness="0"
                      UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid Background="#070B14">
        <wv2:WebView2 x:Name="WebBrowser"
                       DefaultBackgroundColor="#070B14" />
        <Border x:Name="RuntimeRecoveryPanel" Visibility="Collapsed" Background="#070B14" Padding="48">
            <StackPanel MaxWidth="640" VerticalAlignment="Center">
                <TextBlock Text="SplateVPN" Foreground="#F5F9FC" FontSize="28" FontWeight="SemiBold" Margin="0,0,0,24"/>
                <TextBlock x:Name="RuntimeRecoveryTitle" Foreground="#F5F9FC" FontSize="20" TextWrapping="Wrap"/>
                <TextBlock x:Name="RuntimeRecoveryStatus" Foreground="#B7C6DA" FontSize="14" TextWrapping="Wrap" Margin="0,16,0,24"/>
                <WrapPanel>
                    <Button x:Name="RetryRuntimeButton" Content="Повторить запуск" Click="RetryRuntime_Click" Padding="16,10" Margin="0,0,12,12"/>
                    <Button Content="Папка приложения" Click="OpenApplicationFolder_Click" Padding="16,10" Margin="0,0,12,12"/>
                    <Button Content="Закрыть" Click="CloseRuntimeRecovery_Click" Padding="16,10" Margin="0,0,12,12"/>
                </WrapPanel>
            </StackPanel>
        </Border>
    </Grid>
</Window>
