<ui:FluentWindow x:Class="SplateClientDesktop.Views.EditServerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="Редактирование сервера" 
        Height="700" Width="600"
        MinHeight="600" MinWidth="520"
        WindowStartupLocation="CenterOwner"
        ExtendsContentIntoTitleBar="True"
        WindowBackdropType="Mica"
        Background="#0F172A">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Custom TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="Настройка сервера">
            <ui:TitleBar.Header>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="10,0,0,0">
                    <ui:SymbolIcon Symbol="Edit24" FontSize="15" Foreground="#10B981" Margin="0,0,8,0" VerticalAlignment="Center"/>
                    <TextBlock Text="Конфигурация узла" FontWeight="SemiBold" FontSize="12.5" VerticalAlignment="Center" Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                </StackPanel>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- Main Form Content -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="24,12,24,16">
            <StackPanel>
                
                <!-- Main Info Card -->
                <ui:Card Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ОСНОВНЫЕ ПАРАМЕТРЫ" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>

                        <!-- Name -->
                        <TextBlock Text="Название сервера" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtName" PlaceholderText="Например: 🇩🇪 Германия · HighSpeed" Margin="0,0,0,12"/>

                        <!-- Protocol & Network -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Протокол" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbProtocol" SelectionChanged="CmbProtocol_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="VLESS" Tag="vless"/>
                                    <ComboBoxItem Content="VMess" Tag="vmess"/>
                                    <ComboBoxItem Content="Trojan" Tag="trojan"/>
                                    <ComboBoxItem Content="Shadowsocks" Tag="shadowsocks"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Транспорт (Network)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbNetwork" SelectionChanged="CmbNetwork_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="TCP" Tag="tcp"/>
                                    <ComboBoxItem Content="XHTTP (SplitHTTP)" Tag="xhttp"/>
                                    <ComboBoxItem Content="WebSocket (WS)" Tag="ws"/>
                                    <ComboBoxItem Content="gRPC" Tag="grpc"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- Address & Port -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="1*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Адрес хоста / IP" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtAddress" PlaceholderText="example.com или 1.2.3.4"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Порт" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtPort" PlaceholderText="443"/>
                            </StackPanel>
                        </Grid>

                        <!-- UUID / Password -->
                        <TextBlock x:Name="LblUuid" Text="UUID пользователя" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtUuid" PlaceholderText="00000000-0000-0000-0000-000000000000"/>
                    </StackPanel>
                </ui:Card>

                <!-- Security & TLS / Reality Card -->
                <ui:Card Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="БЕЗОПАСНОСТЬ И МАСКИРОВКА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>

                        <!-- Security Mode & Fingerprint -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Шифрование (Security)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbSecurity" SelectionChanged="CmbSecurity_SelectionChanged" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="XTLS Reality" Tag="reality"/>
                                    <ComboBoxItem Content="Стандартный TLS" Tag="tls"/>
                                    <ComboBoxItem Content="Отсутствует (None)" Tag="none"/>
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Fingerprint (uTLS)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ComboBox x:Name="CmbFingerprint" HorizontalAlignment="Stretch">
                                    <ComboBoxItem Content="chrome" Tag="chrome"/>
                                    <ComboBoxItem Content="firefox" Tag="firefox"/>
                                    <ComboBoxItem Content="safari" Tag="safari"/>
                                    <ComboBoxItem Content="ios" Tag="ios"/>
                                    <ComboBoxItem Content="edge" Tag="edge"/>
                                    <ComboBoxItem Content="random" Tag="random"/>
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <!-- SNI / ServerName -->
                        <TextBlock Text="SNI (Имя маскировочного домена)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                        <ui:TextBox x:Name="TxtSni" PlaceholderText="www.amazon.com, speedtest.net и др." Margin="0,0,0,12"/>

                        <!-- Reality Specific: Public Key -->
                        <StackPanel x:Name="PnlReality" Margin="0,0,0,0">
                            <TextBlock Text="Reality Public Key (pbk)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtPublicKey" PlaceholderText="Публичный ключ Reality сервера" Margin="0,0,0,12"/>

                            <Grid Margin="0,0,0,12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Short ID (sid)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ui:TextBox x:Name="TxtShortId" PlaceholderText="например: 16 или a1b2c3"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="SpiderX (spx)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ui:TextBox x:Name="TxtSpiderX" PlaceholderText="/ или путь spider"/>
                                </StackPanel>
                            </Grid>

                            <!-- Flow -->
                            <TextBlock Text="Flow (XTLS Vision)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                            <ui:TextBox x:Name="TxtFlow" PlaceholderText="xtls-rprx-vision" Margin="0,0,0,0"/>
                        </StackPanel>

                    </StackPanel>
                </ui:Card>

                <!-- Transport Extra Card (Path, Host, XHTTP) -->
                <ui:Card x:Name="CardTransport" Padding="18,14" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="ПАРАМЕТРЫ ТРАНСПОРТА" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,10"/>

                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Путь (Path / serviceName)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtPath" PlaceholderText="/ или gun"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Host (HTTP Заголовок)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                <ui:TextBox x:Name="TxtHost" PlaceholderText="host.example.com"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel x:Name="PnlXhttp" Margin="0,0,0,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="12"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Режим XHTTP" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ComboBox x:Name="CmbMode" HorizontalAlignment="Stretch">
                                        <ComboBoxItem Content="auto" Tag="auto"/>
                                        <ComboBoxItem Content="stream-one" Tag="stream-one"/>
                                        <ComboBoxItem Content="stream-up" Tag="stream-up"/>
                                        <ComboBoxItem Content="packet-up" Tag="packet-up"/>
                                    </ComboBox>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Padding (Байты отступа)" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,4"/>
                                    <ui:TextBox x:Name="TxtPadding" PlaceholderText="100-1000"/>
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </StackPanel>
                </ui:Card>

            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Action Bar -->
        <Border Grid.Row="2" Background="#141E33" BorderThickness="0,1,0,0" BorderBrush="#22FFFFFF" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <ui:Button Content="Отмена" Appearance="Secondary" Click="Cancel_Click" Margin="0,0,10,0" Padding="18,7"/>
                <ui:Button Content="Сохранить" Appearance="Primary" Click="Save_Click" Padding="22,7" FontWeight="SemiBold"/>
            </StackPanel>
        </Border>

    </Grid>
</ui:FluentWindow>
