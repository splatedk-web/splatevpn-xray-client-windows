<Page x:Class="SplateClientDesktop.Views.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:SplateClientDesktop.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="850" d:DesignWidth="800"
      Title="Settings">

    <Page.Resources>
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style x:Key="CardLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorTertiaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,5"/>
        </Style>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="18,12,18,20">
        <StackPanel>

            <!-- 2-Column Settings Layout -->
            <Grid Margin="0,0,0,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*"/>
                    <ColumnDefinition Width="14"/>
                    <ColumnDefinition Width="1*"/>
                </Grid.ColumnDefinitions>

                <!-- ========================================== -->
                <!-- LEFT COLUMN: Routing, DNS & Circumvention  -->
                <!-- ========================================== -->
                <StackPanel Grid.Column="0">
                    
                    <!-- Routing & Protocol Card -->
                    <ui:Card Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="ArrowRouting24" FontSize="16" Foreground="#10B981" Margin="0,0,8,0"/>
                                <TextBlock Text="Маршрутизация и DNS" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>
                            
                            <!-- Routing Mode -->
                            <TextBlock Text="РЕЖИМ ПРАВИЛ" Style="{StaticResource CardLabel}"/>
                            <ComboBox SelectedValue="{Binding SelectedRoutingMode}" 
                                      SelectedValuePath="Tag" Margin="0,0,0,12"
                                      HorizontalAlignment="Stretch">
                                <ComboBoxItem Tag="smart_ru">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🇷🇺" Margin="0,0,8,0"/>
                                        <TextBlock Text="Умный — RU-сервисы и банки напрямую"/>
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="global">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="🌍" Margin="0,0,8,0"/>
                                        <TextBlock Text="Глобальный — абсолютно весь трафик в VPN"/>
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>

                            <!-- DNS Provider (All 6 DNS Providers) -->
                            <TextBlock Text="DNS ПРОВАЙДЕР" Style="{StaticResource CardLabel}"/>
                            <ComboBox SelectedValue="{Binding SelectedDnsProvider}" 
                                      SelectedValuePath="Tag"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                <ComboBoxItem Content="Cloudflare DoH (1.1.1.1)" Tag="cloudflare"/>
                                <ComboBoxItem Content="Google DoH (8.8.8.8)" Tag="google"/>
                                <ComboBoxItem Content="Quad9 DoH (9.9.9.9 — защита от малвари)" Tag="quad9"/>
                                <ComboBoxItem Content="AdGuard DNS (Блокировка рекламы)" Tag="adguard"/>
                                <ComboBoxItem Content="Яндекс DNS (tcp://77.88.8.8:53 — быстро в РФ)" Tag="yandex"/>
                                <ComboBoxItem Content="Xbox AI DNS (xbox-dns.ru — обход ИИ)" Tag="xbox"/>
                            </ComboBox>

                            <!-- FakeDNS -->
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="FakeDNS (Ускорение DNS)" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Виртуальные IP 198.18.0.0/15 для нулевых задержек" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding IsFakeDns}" Margin="0"/>
                            </Grid>

                            <Separator Margin="0,2,0,10" Background="#14FFFFFF"/>

                            <!-- TLS ClientHello Fragment -->
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Margin="0,0,8,0">
                                    <TextBlock Text="Фрагментация TLS (Обход ТСПУ/РКН)" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Дробление ClientHello пакетов против блокировок DPI" FontSize="10" TextWrapping="Wrap" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableTlsFragment}" Margin="0"/>
                            </Grid>

                            <!-- AI Bypass -->
                            <Grid Margin="0,2,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Обход блокировок ИИ" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Разблокировка ChatGPT, Gemini, Claude, Copilot" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableAiBypass}" Margin="0"/>
                            </Grid>

                            <!-- XHTTP Mode Override -->
                            <TextBlock Text="РЕЖИМ ПЕРЕДАЧИ XHTTP (OVERRIDE)" Style="{StaticResource CardLabel}"/>
                            <ComboBox SelectedValue="{Binding XhttpModeOverride}" 
                                      SelectedValuePath="Tag"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,12">
                                <ComboBoxItem Content="Авто (по умолчанию из ссылки)" Tag="auto"/>
                                <ComboBoxItem Content="stream-one (однонаправленный поток)" Tag="stream-one"/>
                                <ComboBoxItem Content="stream-up (поток на отдачу)" Tag="stream-up"/>
                                <ComboBoxItem Content="packet-up (пакетный режим)" Tag="packet-up"/>
                            </ComboBox>

                            <Separator Margin="0,2,0,10" Background="#14FFFFFF"/>

                            <!-- Custom Routing Rules -->
                            <TextBlock Text="ВСЕГДА ЧЕРЕЗ VPN (ДОМЕНЫ / IP)" Style="{StaticResource CardLabel}"/>
                            <ui:TextBox Text="{Binding CustomProxyRules, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="example.com, 1.2.3.4 (через запятую или новую строку)"
                                        AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto"
                                        FontSize="11" FontFamily="Cascadia Code, Consolas" Margin="0,0,0,10"/>

                            <TextBlock Text="ВСЕГДА НАПРЯМУЮ / ИСКЛЮЧЕНИЯ" Style="{StaticResource CardLabel}"/>
                            <ui:TextBox Text="{Binding CustomDirectRules, UpdateSourceTrigger=PropertyChanged}"
                                        PlaceholderText="mydomain.ru, 192.168.1.0/24 (через запятую или новую строку)"
                                        AcceptsReturn="True" Height="50" VerticalScrollBarVisibility="Auto"
                                        FontSize="11" FontFamily="Cascadia Code, Consolas"/>
                        </StackPanel>
                    </ui:Card>

                    <!-- System Card -->
                    <ui:Card Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="Desktop24" FontSize="16" Foreground="#60A5FA" Margin="0,0,8,0"/>
                                <TextBlock Text="Интеграция с Windows" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Автозапуск при старте Windows" FontSize="12" VerticalAlignment="Center"/>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoStart}" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Сворачивать в системный трей" FontSize="12" VerticalAlignment="Center"/>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding MinimizeToTray}" Margin="0"/>
                            </Grid>

                            <Separator Margin="0,6,0,8" Background="#14FFFFFF"/>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Автообновление подписок" FontSize="12" VerticalAlignment="Center"/>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoUpdateSubscription}" Margin="0"/>
                            </Grid>

                            <TextBlock Text="ИНТЕРВАЛ ОБНОВЛЕНИЯ ПОДПИСОК" Style="{StaticResource CardLabel}" Margin="0,6,0,5"/>
                            <ComboBox SelectedValue="{Binding SubAutoUpdateInterval}" 
                                      SelectedValuePath="Tag"
                                      HorizontalAlignment="Stretch" Margin="0,0,0,10">
                                <ComboBoxItem Content="Каждые 6 часов" Tag="6h"/>
                                <ComboBoxItem Content="Каждые 12 часов" Tag="12h"/>
                                <ComboBoxItem Content="Раз в сутки (24 часа)" Tag="24h"/>
                                <ComboBoxItem Content="Раз в 2 дня (48 часов)" Tag="48h"/>
                            </ComboBox>

                            <ui:Button Command="{Binding NavigateToServersCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" Height="32">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Globe24" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Управление подписками в разделе «Серверы»" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>

                <!-- ========================================== -->
                <!-- RIGHT COLUMN: Security, Tunnel & Service   -->
                <!-- ========================================== -->
                <StackPanel Grid.Column="2">
                    
                    <!-- Security Card -->
                    <ui:Card Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Foreground="#A78BFA" Margin="0,0,8,0"/>
                                <TextBlock Text="Безопасность и Сеть" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Sniffing (определение домена)" FontSize="12"/>
                                    <TextBlock Text="Определение реальных хостов в TLS" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableSniffing}" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Маршрутизировать только по Sniffing" FontSize="12"/>
                                    <TextBlock Text="Использовать для роутинга только домен из SNI" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding RouteOnlySniffing}" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Блокировка QUIC (HTTP/3)" FontSize="12"/>
                                    <TextBlock Text="Принудительный TCP против замедлений провайдера" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BlockQuic}" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Блокировка IPv6" FontSize="12"/>
                                    <TextBlock Text="Защита от утечек сетевого трафика" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding BlockIpv6}" Margin="0"/>
                            </Grid>

                            <Separator Margin="0,6,0,8" Background="#14FFFFFF"/>

                            <!-- Advanced Features Switches -->
                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="TUN Режим (Виртуальный адаптер Wintun)" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Маршрутизация трафика всех приложений и игр" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableTunMode}" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Kill Switch (Брандмауэр Windows)" FontSize="12" FontWeight="SemiBold"/>
                                    <TextBlock Text="Блокировать трафик при разрыве VPN-соединения" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableKillSwitch}" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Защита от утечек DNS (No Multi-Homed)" FontSize="12"/>
                                    <TextBlock Text="Отключение параллельного DNS в Windows" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding EnableDnsLeakProtection}" Margin="0"/>
                            </Grid>

                            <Grid Margin="0,3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Auto-Fallback (Автовыбор узла)" FontSize="12"/>
                                    <TextBlock Text="Автопереключение на лучший узел при потерях" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>
                                <ui:ToggleSwitch Grid.Column="1" IsChecked="{Binding AutoFallbackFastestServer}" Margin="0"/>
                            </Grid>

                            <Separator Margin="0,6,0,8" Background="#14FFFFFF"/>

                            <!-- Geo Database Update -->
                            <ui:Button Command="{Binding UpdateGeoAssetsCommand}" Appearance="Secondary" HorizontalAlignment="Stretch" Height="34">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ArrowSync24" FontSize="13" Margin="0,0,8,0"/>
                                    <TextBlock Text="Обновить геобазы правил (geoip / geosite)" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </ui:Card>

                    <!-- Windows Service Mode Card -->
                    <ui:Card Padding="16,14" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="WindowShield24" FontSize="16" Foreground="#38BDF8" Margin="0,0,8,0"/>
                                <TextBlock Text="Служба Windows (Автономный режим)" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <TextBlock Text="Запуск VPN-ядра как системной службы Windows. Защищает интернет ещё до авторизации пользователя в Windows."
                                       FontSize="10.5" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" Margin="0,0,0,10"/>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="8"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <ui:Button Grid.Column="0" Command="{Binding InstallWindowsServiceCommand}" Appearance="Primary" Height="32" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Add24" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Установить" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>

                                <ui:Button Grid.Column="2" Command="{Binding UninstallWindowsServiceCommand}" Appearance="Secondary" Height="32" HorizontalAlignment="Stretch">
                                    <StackPanel Orientation="Horizontal">
                                        <ui:SymbolIcon Symbol="Delete24" FontSize="12" Margin="0,0,6,0"/>
                                        <TextBlock Text="Удалить" FontSize="11.5"/>
                                    </StackPanel>
                                </ui:Button>
                            </Grid>
                        </StackPanel>
                    </ui:Card>

                    <!-- About Card -->
                    <ui:Card Padding="16,14">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                <ui:SymbolIcon Symbol="Info24" FontSize="16" Foreground="#F59E0B" Margin="0,0,8,0"/>
                                <TextBlock Text="О приложении" Style="{StaticResource SectionHeader}"/>
                            </StackPanel>

                            <TextBlock Text="SplateVPN Desktop (Windows)" FontSize="13.5" FontWeight="Bold" Margin="0,0,0,2"/>
                            <TextBlock Text="Версия 2.7.0 · Xray Core 26.9.9 · Wintun Tun2socks" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,0,10"/>

                            <ui:Button Appearance="Secondary" HorizontalAlignment="Stretch" Height="32" Command="{Binding OpenUrlCommand}" CommandParameter="https://github.com/splatedk-web/splatevpn-xray-client-windows">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Open24" FontSize="12" Margin="0,0,6,0"/>
                                    <TextBlock Text="Репозиторий GitHub" FontSize="11.5"/>
                                </StackPanel>
                            </ui:Button>
                        </StackPanel>
                    </ui:Card>

                </StackPanel>
            </Grid>

            <!-- Save Settings Button -->
            <ui:Button Command="{Binding SaveSettingsCommand}" Appearance="Primary"
                       HorizontalAlignment="Stretch" Height="40" FontWeight="SemiBold" FontSize="13">
                <StackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="Save24" FontSize="14" Margin="0,0,8,0"/>
                    <TextBlock Text="Сохранить настройки"/>
                </StackPanel>
            </ui:Button>

        </StackPanel>
    </ScrollViewer>
</Page>
