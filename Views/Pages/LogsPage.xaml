<Page x:Class="SplateClientDesktop.Views.Pages.LogsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      xmlns:viewmodels="clr-namespace:SplateClientDesktop.ViewModels"
      mc:Ignorable="d" 
      d:DesignHeight="600" d:DesignWidth="800"
      Title="Logs">

    <Grid Margin="20,16,20,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header Card -->
        <ui:Card Grid.Row="0" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,2">
                        <ui:SymbolIcon Symbol="DocumentBulletList24" FontSize="16" Foreground="#10B981" Margin="0,0,8,0"/>
                        <TextBlock Text="Диагностический журнал (Live Logs)" FontSize="15" FontWeight="SemiBold"/>
                    </StackPanel>
                    <TextBlock Text="Журнал событий ядра Xray и статусов туннеля VPN в реальном времени" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </StackPanel>

                <!-- Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <ui:Button Appearance="Secondary" Padding="12,6" Margin="0,0,8,0" Click="CopyLogs_Click" ToolTip="Скопировать логи в буфер обмена">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Copy24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Копировать"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Secondary" Padding="12,6" Margin="0,0,8,0" Click="ExportLogs_Click" ToolTip="Сохранить лог в текстовый файл">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="ArrowDownload24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Экспорт"/>
                        </StackPanel>
                    </ui:Button>

                    <ui:Button Appearance="Danger" Padding="12,6" Command="{Binding ClearLogsCommand}" ToolTip="Очистить весь журнал">
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="Delete24" FontSize="14" Margin="0,0,6,0"/>
                            <TextBlock Text="Очистить"/>
                        </StackPanel>
                    </ui:Button>
                </StackPanel>
            </Grid>
        </ui:Card>

        <!-- Filter Bar -->
        <ui:Card Grid.Row="1" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Category Chips -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="RbFilterAll" Content="Все логи" IsChecked="True" Checked="Filter_Changed" GroupName="LogFilter" Margin="0,0,8,0" FontSize="11.5"/>
                    <RadioButton x:Name="RbFilterXray" Content="Xray Core" Checked="Filter_Changed" GroupName="LogFilter" Margin="0,0,8,0" FontSize="11.5"/>
                    <RadioButton x:Name="RbFilterVpn" Content="VPN / Клиент" Checked="Filter_Changed" GroupName="LogFilter" Margin="0,0,8,0" FontSize="11.5"/>
                    <RadioButton x:Name="RbFilterErrors" Content="Ошибки" Checked="Filter_Changed" GroupName="LogFilter" FontSize="11.5"/>
                </StackPanel>

                <!-- Search Box -->
                <ui:TextBox Grid.Column="2" x:Name="TxtSearch" PlaceholderText="Поиск по строкам лога..." 
                            TextChanged="TxtSearch_TextChanged" Margin="0,0,12,0" FontSize="12"/>

                <!-- Auto-scroll checkbox -->
                <CheckBox Grid.Column="3" x:Name="ChkAutoScroll" Content="Автопрокрутка" IsChecked="True" FontSize="11.5" VerticalAlignment="Center"/>
            </Grid>
        </ui:Card>

        <!-- Terminal Log Box -->
        <Border Grid.Row="2" Background="#0A0F1D" CornerRadius="10" BorderBrush="#2038BDF8" BorderThickness="1" Padding="10">
            <TextBox x:Name="TxtLogOutput" IsReadOnly="True" 
                     VerticalScrollBarVisibility="Auto" 
                     HorizontalScrollBarVisibility="Auto"
                     FontFamily="Cascadia Code, Cascadia Mono, Consolas, Courier New" 
                     FontSize="11.5" 
                     TextWrapping="NoWrap" 
                     Background="Transparent" 
                     Foreground="#93C5FD"
                     BorderThickness="0" 
                     Padding="8"
                     CaretBrush="#38BDF8"/>
        </Border>
    </Grid>
</Page>
