<Window x:Class="SplateClientDesktop.Views.CompactOverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="SplateVPN Overlay"
        Height="130" Width="280"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Border Background="{DynamicResource AppSurfaceBrush}" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource AppBorderSubtleBrush}" Margin="5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="4" Opacity="0.5" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="12,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Top Row: Title, Drag hint & Controls -->
            <Grid Grid.Row="0" Margin="0,0,0,6">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="8" Height="8" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="{DynamicResource AppAccentCrimsonBrush}"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Fill" Value="{DynamicResource AppAccentEmeraldBrush}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Fill" Value="{DynamicResource AppAccentCyanBrush}"/></DataTrigger>
                            </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="SplateVPN" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AppTextSecondaryBrush}"/>
                    <TextBlock Text="{Binding SelectedServer.DisplayName, StringFormat=' · {0}'}" FontSize="10.5" Foreground="{DynamicResource AppTextSecondaryBrush}" TextTrimming="CharacterEllipsis" MaxWidth="120" Margin="2,0,0,0"/>
                </StackPanel>

                <!-- Actions: Restore Main Window / Hide Overlay -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Click="RestoreMainWindow_Click" ToolTip="Открыть главное окно"
                            Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand" Foreground="{DynamicResource AppTextSecondaryBrush}">
                        <ui:SymbolIcon Symbol="ArrowMaximize20" FontSize="12"/>
                    </Button>
                    <Button Click="CloseOverlay_Click" ToolTip="Скрыть оверлей"
                            Background="Transparent" BorderThickness="0" Padding="4,2" Cursor="Hand" Foreground="{DynamicResource AppTextSecondaryBrush}" Margin="4,0,0,0">
                        <ui:SymbolIcon Symbol="Dismiss20" FontSize="12"/>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- Middle Row: Speeds and Connect Button -->
            <Grid Grid.Row="1" VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Telemetry -->
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <ui:SymbolIcon Symbol="ArrowDown20" FontSize="12" Foreground="{DynamicResource AppAccentCyanBrush}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding DownloadSpeed}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentCyanBrush}"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="ArrowUp20" FontSize="12" Foreground="{DynamicResource AppAccentVioletBrush}" Margin="0,0,4,0"/>
                        <TextBlock Text="{Binding UploadSpeed}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AppAccentVioletBrush}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Toggle Button -->
                <ui:Button Grid.Column="1" Command="{Binding ToggleConnectionCommand}"
                           Padding="12,6" Height="34" FontWeight="SemiBold" FontSize="11.5" Cursor="Hand">
                    <ui:Button.Style>
                        <Style TargetType="ui:Button" BasedOn="{StaticResource {x:Type ui:Button}}">
                            <Setter Property="Appearance" Value="Primary"/>
                            <Setter Property="Content" Value="Включить"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="Appearance" Value="Danger"/>
                                    <Setter Property="Content" Value="Стоп"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding IsConnecting}" Value="True"><Setter Property="Content" Value="Стоп"/></DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ui:Button.Style>
                </ui:Button>
            </Grid>
        </Grid>
    </Border>
</Window>
